<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/carpolo_black</item>
        <item name="android:colorBackground">@color/carpolo_black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/carpolo_black</item>
        <item name="android:navigationBarColor">@color/carpolo_black</item>
        <item name="android:colorAccent">@color/carpolo_turquoise</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Android 12+ launch splash: turquoise with the launcher icon. -->
        <item name="android:windowSplashScreenBackground">@color/carpolo_turquoise</item>
    </style>
</resources>
